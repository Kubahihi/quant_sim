# Copy this file to .streamlit/secrets.toml and set your real key.
# Keep "development" locally. Set this to "production" in Streamlit Cloud.
QUANT_SIM_ENV = "development"

# In production, this one secret overrides [wharton_users] and is applied to
# all four Wharton accounts. Keep it out of the repository.
# WHARTON_SHARED_PASSWORD = "replace-with-a-strong-password"

# The app resolves key in this order:
# 1) st.secrets["GROQ_API_KEY"]
# 2) environment variable GROQ_API_KEY

GROQ_API_KEY = "replace-with-your-groq-api-key"

# Shared online database (Turso / libSQL).
# Create these values in Turso and add the real values only to your local
# secrets.toml or to Streamlit Cloud's Secrets settings.
TURSO_DATABASE_URL = "libsql://your-database.turso.io"
TURSO_AUTH_TOKEN = "your-turso-auth-token"
# How often this app instance pulls changes made by other replicas. Writes from
# this instance remain immediately readable. Lower values trade speed for freshness.
TURSO_SYNC_INTERVAL_SECONDS = 30

# Local login credentials for the Wharton Cockpit. A configured top-level
# WHARTON_PASSWORD overrides these values for all four accounts. Use 10-72
# UTF-8 bytes; do not commit live values.
[wharton_users]
Jakub = "replace-with-a-strong-password"
"Lukáš" = "replace-with-a-strong-password"
Martin = "replace-with-a-strong-password"
"Matěj" = "replace-with-a-strong-password"

# Persistent file storage for production.
[storage]
STORAGE_BACKEND = "r2"
R2_BUCKET = "your-r2-bucket"
R2_ENDPOINT_URL = "https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID = "your-r2-access-key-id"
R2_SECRET_ACCESS_KEY = "your-r2-secret-access-key"
R2_REGION = "auto"
